# Copy to .env and fill in. The .env file is gitignored.
# docker compose automatically loads .env from the project root.

# --- Required ---
DISCORD_WEBHOOK=https://discord.com/api/webhooks/ID/TOKEN

# Format: "port:Display Name[:max_players]", comma-separated.
# Example two-server setup:
#   HALO_SERVERS=2310:Public:4,2312:Scrims:4
HALO_SERVERS=2310:Public:4,2312:Scrims:4

# --- Optional ---

# proxycheck.io API key. Without it: 100 VPN lookups/day. With it: 1000/day.
PROXYCHECK_KEY=

# Per-port join password for the "connect" command embedded on joins.
SERVER_PASSWORDS=2312:changeme

# Public IP override (auto-detected via icanhazip.com if unset).
PUBLIC_IP=

# Per-port IP override (multi-VPS setups).
SERVER_IPS=

# Grafana admin login. CHANGE THESE before exposing port 3000.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ROOT_URL=http://localhost:3000

# Detection thresholds (defaults are sane for small Halo CE servers)
PPS_THRESHOLD=3000
BPS_THRESHOLD=8388608
UNIQUE_IPS_THRESHOLD=40
UNIQUE_IPS_WINDOW_SEC=10
ALERT_COOLDOWN_SEC=60
POLL_SEC=2
METRICS_PORT=9100
